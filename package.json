{
  "name": "keuangan-alkautsar",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "typescript": "^6.0.3",
      "varlock": "1.18.0",
      "lucide-react": "^1.41.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.8",
      "tailwindcss": "^4.3.3",
      "better-auth": "1.7.7",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.7",
      "drizzle-orm": "1.0.0-rc.4"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web --",
    "db:push": "turbo run db:push -F @keuangan-alkautsar/db --",
    "db:studio": "turbo run db:studio -F @keuangan-alkautsar/db --",
    "db:generate": "turbo run db:generate -F @keuangan-alkautsar/db --",
    "db:migrate": "turbo run db:migrate -F @keuangan-alkautsar/db --",
    "db:seed": "turbo run db:seed -F web --",
    "db:seed:admin": "turbo run db:seed:admin -F web --",
    "db:start": "docker compose up -d postgres",
    "db:watch": "docker compose up postgres",
    "db:stop": "docker compose stop postgres",
    "db:down": "docker compose down postgres",
    "storage:start": "docker compose up -d rustfs",
    "storage:stop": "docker compose stop rustfs",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
    "auth:generate": "cd apps/web && bun run auth:generate",
    "check": "oxlint && oxfmt --write"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@keuangan-alkautsar/config": "workspace:*",
    "@types/node": "^26.4.1",
    "lefthook": "^2.1.12",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "varlock": "catalog:"
  },
  "packageManager": "bun@1.4.2"
}
