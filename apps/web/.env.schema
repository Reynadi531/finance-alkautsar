# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# Vercel bakes the resolved env into the server bundle; encrypt it with _VARLOCK_ENV_KEY.
# @encryptInjectedEnv=if($VERCEL, true, false)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# System variables Vercel sets at build and runtime; empty everywhere else.
# @required=false @sensitive=false
VERCEL=
# @required=false @sensitive=false @type=enum(development, preview, production)
VERCEL_ENV=
# @required=false @sensitive=false
VERCEL_URL=
# @required=false @sensitive=false
VERCEL_PROJECT_PRODUCTION_URL=

# On Vercel, defaults to the production domain, or the deployment URL on previews.
# Set it explicitly elsewhere, or to pin a custom domain.
# @type=url
BETTER_AUTH_URL=if(eq($VERCEL_ENV, production), concat("https://", $VERCEL_PROJECT_PRODUCTION_URL), if($VERCEL_URL, concat("https://", $VERCEL_URL)))

# @type=string(minLength=1)
DATABASE_URL=

# Object storage for uploads. Dev: RustFS from docker compose (`bun storage:start`).
# Leave S3_ENDPOINT empty to use AWS S3.
# @required=false @sensitive=false @type=url
S3_ENDPOINT=
# @sensitive=false
S3_REGION=us-east-1
# @sensitive=false
S3_BUCKET=keuangan-alkautsar
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
