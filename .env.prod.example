# Template for docker-compose.prod.yml. Copy to .env next to the compose file and fill in.
# Generate secrets with: openssl rand -base64 48 (auth) / openssl rand -hex 24 (passwords)

# Public URL users open; Better Auth uses it for callbacks and cookies
BETTER_AUTH_URL=https://finance.example.com
# 32+ characters
BETTER_AUTH_SECRET=

POSTGRES_PASSWORD=

RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

# Optional
WEB_IMAGE_TAG=latest
WEB_PORT=3001
